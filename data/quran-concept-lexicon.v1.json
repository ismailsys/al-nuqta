{
  "schema_version": "1.0.0",
  "title": "SAKINA Quranic concept lexicon",
  "purpose": "Expand a user's description into research concepts. This file does not assert that a concept or symptom is explicitly mentioned in the Quran, nor does it assign verses.",
  "language_support": [
    "fr",
    "ar",
    "ary",
    "en"
  ],
  "matching_policy": {
    "normalize_arabic": [
      "remove_tashkeel",
      "normalize_alef",
      "normalize_yaa",
      "normalize_taa_marbuta_for_search_only"
    ],
    "never_infer_direct_match_from_translation_alone": true,
    "root_expansion_requires_verified_morphology": true,
    "context_review_required": true,
    "no_medical_or_spiritual_cure_claims": true
  },
  "relationship_types": [
    {
      "id": "direct_lexical",
      "label_fr": "Correspondance lexicale",
      "description_fr": "Le terme ou une forme linguistique vérifiée apparaît dans le texte arabe."
    },
    {
      "id": "semantic",
      "label_fr": "Lien de sens",
      "description_fr": "Le passage traite d'une notion proche, sans nommer directement le problème."
    },
    {
      "id": "contextual",
      "label_fr": "Lien contextuel",
      "description_fr": "Le passage complet, et non un mot isolé, justifie le rapprochement."
    },
    {
      "id": "spiritual_reflection",
      "label_fr": "Réflexion spirituelle",
      "description_fr": "Le passage peut nourrir la réflexion, l'invocation, la patience ou l'espérance ; ce n'est pas une réponse médicale."
    }
  ],
